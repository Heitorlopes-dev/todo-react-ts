rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: verifica se o usuário autenticado é o dono do recurso
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Cada usuário só acessa suas próprias tarefas
    match /users/{userId}/tasks/{taskId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['name', 'completed', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'completed', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 500
        && request.resource.data.completed is bool
        && request.resource.data.completed == false
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'completed'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 500
        && request.resource.data.completed is bool;

      allow delete: if isOwner(userId);
    }

    // Nenhum outro acesso permitido
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
