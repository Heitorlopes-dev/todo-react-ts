rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: verifica se o usuário autenticado é o dono do recurso
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper: verifica se o usuário tem a role admin
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Regras para o documento raiz do usuário
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      // Permitir criação se o usuário for o dono e a role inserida for apenas 'user' (ou omitida)
      allow create: if isOwner(userId) 
        && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'user')
        && (!request.resource.data.keys().hasAny(['email']) || (request.resource.data.email is string && request.resource.data.email.size() <= 254))
        && (!request.resource.data.keys().hasAny(['displayName']) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 150));
      
      // Permitir atualização apenas se o usuário for o dono e NÃO tentar alterar a 'role'
      // Administradores podem atualizar tudo
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
                    && (!request.resource.data.keys().hasAny(['email']) || (request.resource.data.email is string && request.resource.data.email.size() <= 254))
                    && (!request.resource.data.keys().hasAny(['displayName']) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 150))
                    || isAdmin();
                    
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Cada usuário só acessa suas próprias tarefas
    match /users/{userId}/tasks/{taskId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['name', 'completed', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'completed', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 500
        && request.resource.data.completed is bool
        && request.resource.data.completed == false
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'completed'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 500
        && request.resource.data.completed is bool;

      allow delete: if isOwner(userId);
    }

    // Regras para a coleção de atividades
    match /users/{userId}/activities/{activityId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['action', 'category', 'description', 'createdAt'])
        && request.resource.data.keys().hasOnly(['action', 'category', 'description', 'createdAt'])
        && request.resource.data.action is string
        && request.resource.data.category is string
        && request.resource.data.description is string
        && request.resource.data.createdAt == request.time;

      allow delete: if isOwner(userId); // Permitido para o usuário limpar seu próprio histórico
      allow update: if false; // Logs de atividade não devem ser modificados
    }

    // Nenhum outro acesso permitido
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
